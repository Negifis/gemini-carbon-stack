{
  "carbon-stack": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "bin\\carbon-stack.exe hook --event SessionStart",
        "timeout": 12
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bin\\carbon-stack.exe hook --event PreInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read_file|run_command|invoke_subagent|swarm|swarm_wait|read_board|post_message|edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "bin\\carbon-stack.exe hook --event PreToolUse",
            "timeout": 12
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bin\\carbon-stack.exe hook --event PostToolUse",
            "timeout": 12
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bin\\carbon-stack.exe hook --event Stop",
        "timeout": 15
      }
    ]
  }
}
