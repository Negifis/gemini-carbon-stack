{
  "continuity": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python -X utf8 hooks/continuity.py --event SessionStart",
        "timeout": 12
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python -X utf8 hooks/continuity.py --event PreInvocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 hooks/continuity.py --event PreToolUse",
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 hooks/continuity.py --event PostToolUse",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python -X utf8 hooks/continuity.py --event Stop",
        "timeout": 10
      }
    ]
  },
  "safety-and-quality-guards": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|run_command|invoke_subagent|swarm",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 hooks/safety_guards.py --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "chip-handoff": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python -X utf8 hooks/chip_hooks.py --event PreInvocation",
        "timeout": 8
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python -X utf8 hooks/chip_hooks.py --event Stop",
        "timeout": 10
      }
    ]
  },
  "code-work-gate": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python -X utf8 hooks/cwg_pre_invocation.py --event PreInvocation",
        "timeout": 8
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|run_command|invoke_subagent|run_workflow|swarm",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 hooks/cwg_mark.py --event PreToolUse",
            "timeout": 12
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|run_command|invoke_subagent|run_workflow|swarm|read_file",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 hooks/cwg_mark.py --event PostToolUse",
            "timeout": 12
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python -X utf8 hooks/cwg_stop.py --event Stop",
        "timeout": 15
      }
    ]
  }
}
