TOKENADE_NO_AUTO_UPDATE="1"
TOKENADE_NO_STAR_INVITE="1"
CONTEXT7_API_KEY="<YOUR_CONTEXT7_API_KEY_OPTIONAL>"
GITHUB_PERSONAL_ACCESS_TOKEN="<YOUR_GITHUB_PAT_OPTIONAL>"
